DEPLOY_ID=local-dev
DB_PASSWORD=openclaw-local-password
ENCRYPTION_KEY=replace-with-a-32-byte-secret # gitleaks:allow -- documented placeholder
AGENT_COUNT=1
AGENT_SERVICE_TOKEN=replace-with-a-shared-internal-token
OPENCLAW_AGENT_MAX_REQUEST_BODY_BYTES=1048576
OPENCLAW_AGENT_API_CALL_ALLOWED_HOSTS=
OPENCLAW_AGENT_ALLOW_PRIVATE_API_CALLS=false
SUPABASE_JWT_SECRET=
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=agent-files
SUPABASE_STORAGE_MAX_BYTES=26214400

# Database host — points to the Supabase Postgres container.
# For local dev: start supabase first (cd supabase && docker compose up -d)
# then start the stack (cd stack && docker compose up -d).
DB_HOST=supabase-db
DB_PORT=5432

# Host interface for development-only published ports. The compose files bind
# dashboards/gateways to loopback by default so they are not accidentally exposed
# on a public VM. Set AIDEPLOY_HOST_BIND=0.0.0.0 only behind a trusted firewall or
# a deliberate tunnel/proxy.
AIDEPLOY_HOST_BIND=127.0.0.1

# Shell-equivalent maintenance patches are disabled in the reference compose
# stack. Set this to ssh-equivalent only when dashboard access is restricted as
# tightly as SSH access, for example behind a locked-down tailnet. When enabled,
# also set a long random AIDEPLOY_MAINTENANCE_TOKEN; dashboard login alone does
# not authorize shell execution.
AIDEPLOY_MAINTENANCE_TAILSCALE_POLICY=disabled
AIDEPLOY_MAINTENANCE_TOKEN=
AIDEPLOY_DASHBOARD_JSON_MAX_BODY_BYTES=65536
AIDEPLOY_DASHBOARD_REQUEST_BODY_LIMIT=1mb

# Enable local knowledge mode by switching the agent config to knowledge_provider=qmd
OPENCLAW_QMD_BASE_URL=http://qmd:4318

# Optional channel tokens
CHANNEL_1_TELEGRAM_TOKEN=
CHANNEL_1_TELEGRAM_SECRET=
CHANNEL_1_WHATSAPP_TOKEN=
CHANNEL_1_WHATSAPP_PHONE_ID=
CHANNEL_1_WHATSAPP_APP_SECRET=
CHANNEL_1_SLACK_TOKEN=
CHANNEL_1_SLACK_SECRET=

# ── KMS / Secret Provider Credentials (optional) ──
# When set, the dashboard and gateway can resolve secret references
# (e.g. doppler://MY_SECRET, aws-sm://my-secret) at runtime instead
# of requiring plain-text values above.
#
# Doppler — primary managed secrets provider
DOPPLER_TOKEN=
DOPPLER_PROJECT=
DOPPLER_CONFIG=
#
# AWS Secrets Manager
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
#
# Google Cloud Secret Manager
GCP_SECRET_MANAGER_TOKEN=
#
# Azure Key Vault
AZURE_KEY_VAULT_TOKEN=

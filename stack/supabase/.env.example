# Supabase Docker Compose — Environment Variables
#
# Copy to .env and fill in values before running:
#   docker compose up -d                              # core runtime + Kong
#   docker compose --profile command_center up -d     # adds Studio/Meta/Functions

# ── Required ──────────────────────────────────────────────────────

# Postgres superuser password (shared across all Supabase services)
POSTGRES_PASSWORD=your-super-secret-db-password

# JWT secret for signing/verifying Supabase tokens (min 32 chars).
# Use a raw secret string, not a 64-character hex-encoded 32-byte value.
JWT_SECRET=your-super-secret-jwt-token-at-least-32-chars

# Realtime DB encryption key (exactly 16 printable chars for AES-128).
REALTIME_DB_ENC_KEY=your-16-char-key

# Anon key — JWT with role=anon, signed with JWT_SECRET
# Generate: see provisioner/src/deployer.ts generateSupabaseJwtKeys()
SUPABASE_ANON_KEY=eyJ...

# Service role key — JWT with role=service_role, signed with JWT_SECRET
# Generate: see provisioner/src/deployer.ts generateSupabaseJwtKeys()
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Optional ──────────────────────────────────────────────────────

# Site URL for GoTrue auth redirects (default: http://localhost:3000)
SITE_URL=http://localhost:3000

# Public Supabase URL exposed through Kong.
SUPABASE_PUBLIC_URL=http://localhost:8000

# Optional host-side backup target. Override these to point backups at a
# separate Supabase project for real off-instance durability.
SUPABASE_BACKUP_TARGET_URL=http://127.0.0.1:8000
SUPABASE_BACKUP_SERVICE_ROLE_KEY=
SUPABASE_BACKUP_BUCKET=aideploy-runtime-backups
SUPABASE_BACKUP_PREFIX=local-dev
SUPABASE_BACKUP_INCLUDE_STORAGE=auto
